{
  "name": "@trsoliu/audio-core",
  "version": "1.0.0-beta.2",
  "description": "Framework-agnostic, typed HTML audio controller.",
  "type": "module",
  "license": "MIT",
  "author": "trsoliu",
  "homepage": "https://trsoliu.github.io/vue-audio-native/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trsoliu/vue-audio-native.git",
    "directory": "packages/audio-core"
  },
  "bugs": {
    "url": "https://github.com/trsoliu/vue-audio-native/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "lint": "eslint src tests scripts vite.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pack": "publint && attw --pack . && size-limit && tsx scripts/check-pack.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.58.12",
    "@size-limit/file": "13.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "publint": "0.3.22",
    "size-limit": "13.0.2",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "8 KB"
    }
  ]
}
