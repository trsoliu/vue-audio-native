{
  "name": "vue-audio-native",
  "version": "1.0.0-beta.2",
  "description": "Accessible Vue 3 audio player for modern browsers and WebViews.",
  "type": "module",
  "license": "MIT",
  "author": "trsoliu",
  "homepage": "https://trsoliu.github.io/vue-audio-native/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trsoliu/vue-audio-native.git",
    "directory": "packages/vue-audio-native"
  },
  "bugs": {
    "url": "https://github.com/trsoliu/vue-audio-native/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vue-audio-native.global.js",
  "jsdelivr": "./dist/vue-audio-native.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "development": "./dist/index.development.js",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "development": "./dist/index.development.cjs",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "lint": "eslint src tests scripts vite.config.ts vitest.config.ts",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pack": "publint && attw --pack . && size-limit && tsx scripts/check-pack.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.27.0",
    "@trsoliu/audio-core": "1.0.0-beta.1"
  },
  "peerDependencies": {
    "vue": ">=3.3 <4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.58.12",
    "@size-limit/file": "13.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.11.1",
    "publint": "0.3.22",
    "size-limit": "13.0.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-tsc": "3.3.8"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "25 KB"
    },
    {
      "path": "dist/style.css",
      "limit": "12 KB"
    }
  ]
}
