{
  "name": "vue-audio-native-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Modern Vue 3 audio player and framework-agnostic audio core.",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "lint": "eslint e2e playwright.config.ts && turbo run lint",
    "security:audit": "pnpm audit --prod --registry=https://registry.npmjs.org",
    "typecheck": "tsc -p tsconfig.tools.json && turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:pack": "turbo run test:pack",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@playwright/test": "catalog:",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "turbo": "2.10.7",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}
